{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/automated-qa-test/test-plan.schema.json",
  "title": "Automated QA Test Plan v2",
  "type": "object",
  "required": ["schemaVersion", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "baseUrl": { "type": "string" },
    "artifactDir": { "type": "string" },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "steps"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["action"],
              "properties": { "action": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    }
  }
}
